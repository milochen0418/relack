# variables for development environment of google login integration
GOOGLE_CLIENT_ID=xxxxg.apps.googleusercontent.com # client id for google oauth integration
GOOGLE_CLIENT_SECRET=xxxxxxx # secret for google oauth integration
ADMIN_PASSCODE=xxxxxx # passcode for admin user creation in environment

# Auth routing (defaults work for local dev)
# BACKEND_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:3000
# Google Console → Authorized redirect URI: http://localhost:8000/auth/google/callback
# Google Console → Authorized JavaScript origins: http://localhost:8000 

# DDNS Intent: where relack opens its own intents (People → profile dialogs).
# Unset, it defaults to https://relack.reflex-ddns.com; set it for local dev.
# DDNS_INTENT_URL_RELACK=http://localhost:3000

# Calls: the app handling the `call.join` intent (default: livekit, i.e.
# https://livekit.reflex-ddns.com). For local dev, point it at a local copy.
# RELACK_CALL_APP=livekit
# DDNS_INTENT_URL_LIVEKIT=http://localhost:3200
